{
  "projectType": "library",
  "tags": ["scope:module"],
  "targets": {
    "lint": {},
    "type-check-src": {},
    "type-check-test": {},
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "sharedGlobals",
        "{workspaceRoot}/packages/*/*/src/**/*.{ts,tsx}",
        "{workspaceRoot}/apps/*/src/**/*.{ts,tsx}"
      ],
      "options": {
        "command": "vitest run --config=vitest.config.js --coverage",
        "cwd": "{projectRoot}"
      }
    },
    "test-watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest watch --config=vitest.config.js",
        "cwd": "{projectRoot}"
      }
    },
    "typedoc": {}
  }
}
