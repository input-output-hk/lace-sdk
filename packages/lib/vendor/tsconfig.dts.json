{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "removeComments": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "../../..",
    "skipLibCheck": true
  },
  "include": [
    "src/seam-cardano.ts",
    "src/ledger-cardano-key-agent.ts",
    "src/trezor-cardano.ts",
    "../cardano-core/src/**/*",
    "../cardano-crypto/src/**/*",
    "../cardano-dapp-connector/src/**/*",
    "../cardano-hardware-ledger/src/**/*",
    "../cardano-hardware-trezor/src/**/*",
    "../cardano-key-management/src/**/*",
    "../cardano-util/src/**/*"
  ]
}
