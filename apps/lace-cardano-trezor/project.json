{
  "name": "lace-cardano-trezor",
  "projectType": "library",
  "tags": ["scope:app", "release:lace-sdk"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/build.sh",
        "cwd": "apps/lace-cardano-trezor"
      },
      "dependsOn": [
        {
          "projects": ["lace-cardano"],
          "target": "build"
        }
      ],
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/packages/lib/cardano-*/src/**/*",
        "{workspaceRoot}/packages/lib/util/src/common/**/*",
        "{workspaceRoot}/apps/lace-cardano/dist/**/*",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "type-check-src": {},
    "lint": {}
  }
}
