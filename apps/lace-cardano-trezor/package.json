{
  "name": "@laceio/cardano-trezor",
  "version": "0.1.0",
  "private": false,
  "description": "Trezor hardware wallet signing for Cardano, over Trezor Connect: the Trezor key agent of the Cardano domain layer Lace builds on.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/input-output-hk/lace-sdk.git",
    "directory": "apps/lace-cardano-trezor"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "@laceio/cardano": "^0.1.1",
    "@trezor/connect": "9.4.0",
    "@trezor/connect-web": "9.4.0",
    "lodash": "^4.17.21",
    "ts-custom-error": "^3.3.1",
    "ts-log": "^2.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
