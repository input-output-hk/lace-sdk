{
  "name": "@laceio/cardano",
  "version": "0.2.0-canary.0",
  "private": false,
  "description": "The Cardano domain layer Lace builds on: ledger types and CBOR, cryptography, key management, the transaction builder and the CIP-30 dApp connector.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/input-output-hk/lace-sdk.git",
    "directory": "apps/lace-cardano"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./crypto": {
      "import": {
        "types": "./dist/crypto.d.ts",
        "default": "./dist/crypto.js"
      },
      "require": {
        "types": "./dist/crypto.d.cts",
        "default": "./dist/crypto.cjs"
      }
    },
    "./util": {
      "import": {
        "types": "./dist/util.d.ts",
        "default": "./dist/util.js"
      },
      "require": {
        "types": "./dist/util.d.cts",
        "default": "./dist/util.cjs"
      }
    },
    "./key-management": {
      "import": {
        "types": "./dist/key-management.d.ts",
        "default": "./dist/key-management.js"
      },
      "require": {
        "types": "./dist/key-management.d.cts",
        "default": "./dist/key-management.cjs"
      }
    },
    "./tx-builder": {
      "import": {
        "types": "./dist/tx-builder.d.ts",
        "default": "./dist/tx-builder.js"
      },
      "require": {
        "types": "./dist/tx-builder.d.cts",
        "default": "./dist/tx-builder.cjs"
      }
    },
    "./dapp-connector": {
      "import": {
        "types": "./dist/dapp-connector.d.ts",
        "default": "./dist/dapp-connector.js"
      },
      "require": {
        "types": "./dist/dapp-connector.d.cts",
        "default": "./dist/dapp-connector.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "crypto": [
        "./dist/crypto.d.ts"
      ],
      "util": [
        "./dist/util.d.ts"
      ],
      "key-management": [
        "./dist/key-management.d.ts"
      ],
      "tx-builder": [
        "./dist/tx-builder.d.ts"
      ],
      "dapp-connector": [
        "./dist/dapp-connector.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "@biglup/is-cid": "1.0.3",
    "@foxglove/crc": "0.0.3",
    "@scure/base": "1.2.6",
    "@types/webextension-polyfill": "~0.12.4",
    "bech32": "2.0.0",
    "bip39": "3.1.0",
    "blake2b": "2.1.4",
    "buffer": "6.0.3",
    "chacha": "2.1.0",
    "fraction.js": "4.0.1",
    "get-random-values": "2.1.0",
    "ip-address": "10.7.4",
    "libsodium-wrappers-sumo": "0.7.10",
    "lodash": "^4.17.21",
    "pbkdf2": "3.1.7",
    "serialize-error": "8.1.0",
    "ts-custom-error": "^3.3.1",
    "ts-log": "^2.2.7",
    "type-fest": "4.41.0",
    "web-encoding": "1.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
